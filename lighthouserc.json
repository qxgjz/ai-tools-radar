{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", {"minScore": 0.7}],
        "categories:accessibility": ["warn", {"minScore": 0.8}],
        "categories:best-practices": ["warn", {"minScore": 0.85}],
        "categories:seo": ["warn", {"minScore": 0.85}],
        "categories:pwa": "off",
        "uses-responsive-images": "off",
        "uses-optimized-images": "off",
        "uses-long-cache-ttl": "off",
        "server-response-time": "off",
        "dom-size": "warn",
        "mainthread-work-breakdown": "warn",
        "render-blocking-resources": "warn",
        "unused-javascript": "warn",
        "unused-css-rules": "warn",
        "total-byte-weight": "warn",
        "network-requests": "off",
        "installable-manifest": "off",
        "splash-screen": "off",
        "themed-omnibox": "off",
        "content-width": "warn",
        "meta-description": "warn",
        "document-title": "warn",
        "link-text": "warn",
        "crawlable-anchors": "warn",
        "is-crawlable": "warn",
        "robots-txt": "warn",
        "image-alt": "warn",
        "label": "warn",
        "aria-valid-attr": "warn",
        "color-contrast": "warn",
        "html-has-lang": "warn",
        "html-lang-valid": "warn",
        "valid-lang": "warn",
        "viewport": "warn",
        "no-document-write": "warn",
        "external-anchors-use-rel-noopener": "warn",
        "geolocation-on-start": "warn",
        "doctype": "warn",
        "no-unload-listeners": "warn",
        "no-vulnerable-libraries": "warn",
        "js-library": "off",
        "notification-on-start": "warn",
        "password-inputs-can-be-pasted-into": "warn",
        "uses-http2": "off",
        "uses-passive-event-listeners": "warn",
        "no-mutation-events": "warn",
        "no-old-flexbox": "warn",
        "modern-image-formats": "off",
        "offscreen-images": "off",
        "preload-lcp-image": "warn",
        "prioritize-lcp-image": "warn",
        "redirects": "warn",
        "uses-text-compression": "warn",
        "efficient-animated-content": "warn",
        "duplicated-javascript": "warn",
        "legacy-javascript": "warn",
        "non-composited-animations": "warn",
        "unsized-images": "warn",
        "layout-shifts": "warn",
        "font-display": "warn",
        "third-party-summary": "off",
        "third-party-facades": "off",
        "bootup-time": "warn",
        "uses-rel-preconnect": "warn",
        "uses-rel-preload": "warn",
        "timing-budget": "off",
        "first-contentful-paint": "warn",
        "largest-contentful-paint": "warn",
        "total-blocking-time": "warn",
        "cumulative-layout-shift": "warn",
        "speed-index": "warn",
        "max-potential-fid": "warn",
        "interactive": "warn",
        "user-timings": "off",
        "performance-budget": "off",
        "long-tasks": "warn",
        "screenshot": "off",
        "full-page-screenshot": "off",
        "final-screenshot": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
